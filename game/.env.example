# Firebase web configuration (public values; access is enforced by rules).
# Copy to .env.local for local development. Never commit real keys.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: point at the local emulator suite.
# VITE_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099
# and set VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-game-night
